# Copy to .env and fill in. Every key is prefixed SENTINEL_ to match sentinel/config.py.

# Storage — SQLite by default; swap for Postgres once docker/docker-compose.yml is running:
# SENTINEL_DATABASE_URL=postgresql+psycopg2://sentinel:sentinel_dev_only@localhost:5432/sentinel
SENTINEL_DATABASE_URL=sqlite:///./sentinel.db

# Control-plane auth. REQUIRED for anything reachable by anyone but you — Phase 0
# verifies domain ownership, never caller identity, so without this any caller who
# can reach the API can start/halt scans or deregister targets someone else set up.
# Every mutating request needs header: Authorization: Bearer <this value>
SENTINEL_API_KEY=

# Required for contract-backed scan runs. Use a long random secret from your
# secret manager; Sentinel signs approvals with it and fails closed if absent.
SENTINEL_CONTROL_PLANE_SIGNING_KEY=
# Hard-capped in code at 900 seconds even if this is set higher.
SENTINEL_CONTROL_PLANE_MAX_LEASE_SECONDS=900

# Optional in this MVP, required to issue a customer-hosted runner permit.
# This is an Ed25519 PRIVATE key encoded as unpadded URL-safe base64 raw
# bytes. Keep it only in the control-plane secret manager. A customer runner
# pins the corresponding public verification key during a separate onboarding
# step; the permit API returns only a non-secret issuer key ID, never either
# key. Do not place this value in customer infrastructure or source control.
SENTINEL_RUNNER_PERMIT_PRIVATE_KEY=
# Fail-closed default. The temporary shared-key permit endpoint can run only
# in an explicitly marked development deployment; do not set this to
# development on a customer or production deployment.
SENTINEL_DEPLOYMENT_MODE=production
# Development-only operator opt-in for the current /runner-permits endpoint.
# Leave false for every deployed environment; production needs enrolled,
# tenant-scoped runner identity instead of this shared-key endpoint.
SENTINEL_ENABLE_DEVELOPMENT_RUNNER_PERMIT_ISSUANCE=false

# Audit log integrity. Unset -> plain SHA-256 (tamper-evident only against parties
# without DB write access). Set to a long random secret and keep it OUTSIDE the
# database (this file, a secrets manager — never a DB column) to switch to
# HMAC-SHA256, so forging a valid chain after editing a row requires this secret.
SENTINEL_AUDIT_LOG_HMAC_KEY=

# LLM — set exactly one. Precedence: anthropic > tokenrouter > openrouter > openai.
SENTINEL_ANTHROPIC_API_KEY=
# TokenRouter: use a newly issued key from your TokenRouter account.
# The safe local AI demo is designed for this option. Its GLM route is asked
# to return raw JSON, then Sentinel validates it locally.
SENTINEL_TOKENROUTER_API_KEY=
SENTINEL_TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
SENTINEL_TOKENROUTER_MODEL=z-ai/glm-5.2-free
# Optional. Leave unset for normal runs. The two-minute local AI demo sets 6.
# SENTINEL_LLM_MAX_CWE_JUDGMENTS=6
# OpenRouter: reached via the OpenAI SDK with a base_url override. Model IDs
# are "provider/model" — e.g. anthropic/claude-sonnet-4.5, openai/gpt-4o-mini,
# google/gemini-2.5-pro. Get a key at https://openrouter.ai/keys
SENTINEL_OPENROUTER_API_KEY=
SENTINEL_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SENTINEL_OPENAI_API_KEY=
# Anthropic-native format by default (claude-sonnet-4-5). If you're using
# OpenRouter, override this to that provider's format, e.g.:
# SENTINEL_LLM_MODEL=anthropic/claude-sonnet-4.5
SENTINEL_LLM_MODEL=claude-sonnet-4-5

# Scan engines
SENTINEL_NUCLEI_BINARY_PATH=nuclei
SENTINEL_NUCLEI_TEMPLATES_PATH=
SENTINEL_NUCLEI_TIMEOUT_SECONDS=300
SENTINEL_ZAP_API_URL=http://localhost:8080
SENTINEL_ZAP_API_KEY=
SENTINEL_ZAP_SPIDER_TIMEOUT_SECONDS=180
SENTINEL_ZAP_ASCAN_TIMEOUT_SECONDS=600

SENTINEL_AUDIT_LOG_FILE=./audit_log.ndjson
